{
  "title": "Shadow Ledger — Overview",
  "uid": "shadow-ledger-overview",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1, "title": "Request rate by path", "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [{ "expr": "sum(rate(http_requests_total[1m])) by (path)", "legendFormat": "{{path}}" }]
    },
    {
      "id": 2, "title": "Error rate (5xx)", "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [{ "expr": "sum(rate(http_requests_total{status=~\"5..\"}[1m])) by (path)", "legendFormat": "{{path}}" }]
    },
    {
      "id": 3, "title": "p95 request latency", "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [{ "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[5m])) by (le, path))", "legendFormat": "{{path}}" }]
    },
    {
      "id": 4, "title": "Fraud-scoring latency (p50/p95/p99)", "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum(rate(fraud_scoring_latency_seconds_bucket[5m])) by (le, dataset))", "legendFormat": "p50 {{dataset}}" },
        { "expr": "histogram_quantile(0.95, sum(rate(fraud_scoring_latency_seconds_bucket[5m])) by (le, dataset))", "legendFormat": "p95 {{dataset}}" },
        { "expr": "histogram_quantile(0.99, sum(rate(fraud_scoring_latency_seconds_bucket[5m])) by (le, dataset))", "legendFormat": "p99 {{dataset}}" }
      ]
    },
    {
      "id": 5, "title": "Cache hit rate", "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [{ "expr": "sum(rate(http_cache_hits_total[5m])) / (sum(rate(http_cache_hits_total[5m])) + sum(rate(http_cache_misses_total[5m])))", "legendFormat": "hit rate" }]
    },
    {
      "id": 6, "title": "Duplicate-payment attempts (should be 0 outside load tests)", "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [{ "expr": "increase(duplicate_payment_attempts_total[5m])", "legendFormat": "attempts" }]
    }
  ]
}
