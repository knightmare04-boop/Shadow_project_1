# Copy to .env and adjust. .env is gitignored — never commit real secrets.

ENV=development

# --- Postgres (must match infra/docker-compose.yml) ---
POSTGRES_USER=ledger
POSTGRES_PASSWORD=ledger_dev_password
POSTGRES_DB=shadow_ledger
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://ledger:ledger_dev_password@localhost:5432/shadow_ledger
# Sync URL for Alembic (asyncpg has no sync driver; psycopg handles both).
DATABASE_URL_SYNC=postgresql+psycopg://ledger:ledger_dev_password@localhost:5432/shadow_ledger

# --- Redis ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# --- Neo4j (optional — app must degrade gracefully if unset/unreachable) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=ledger_dev_password

# --- App ---
SECRET_KEY=change-me-in-production-use-a-real-random-value
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:5173

# --- Observability (Module 8) ---
GLITCHTIP_DSN=
PROMETHEUS_ENABLED=true

# --- Fraud engine (Module 5) ---
SCORING_TIMEOUT_MS=500
SCORING_CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
SCORING_CIRCUIT_BREAKER_RESET_SECONDS=30
